APP_NAME=TirrainStyle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mails (confirmation de commande) ---------------------------------------
# « log » : les e-mails sont écrits dans storage/logs/laravel.log (aucun envoi réel).
# Pour un envoi réel, passez à « smtp » et renseignez votre fournisseur :
#   Gmail : MAIL_HOST=smtp.gmail.com        MAIL_PORT=587  (mot de passe d'application)
#   Brevo : MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587  (identifiant + clé SMTP Brevo)
# Ne commitez jamais vos identifiants : ils vont uniquement dans .env (ignoré par Git).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@tirrainstyle.ma"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SHOP_SHIPPING_FEE=35
SHOP_FREE_SHIPPING_THRESHOLD=500
# Reçoit une alerte à chaque nouvelle commande (laisser vide pour désactiver)
SHOP_ADMIN_EMAIL=
# Reçoit les messages du formulaire de contact (par défaut : SHOP_ADMIN_EMAIL, sinon MAIL_FROM_ADDRESS)
SHOP_CONTACT_INBOX=
